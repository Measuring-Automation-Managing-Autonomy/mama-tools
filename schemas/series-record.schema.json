{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Measuring-Automation-Managing-Autonomy/mama-tools/blob/main/schemas/series-record.schema.json",
  "title": "MAMA metric series record (series_version 1.0.0)",
  "description": "One imported metric observation per row: the seam between an organization's own measurement systems and MAMA computation (indices-and-tracking.md section 4). Rows are append-only; unlabeled rows are rejected; card versions are mandatory.",
  "type": "object",
  "required": [
    "series_version",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "series_version": {
      "const": "1.0.0"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "usecase_id",
          "card_id",
          "card_version",
          "window",
          "value",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "usecase_id": {
            "type": "string",
            "pattern": "^usecase-[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "card_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "card_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "window": {
            "type": "string",
            "minLength": 4
          },
          "value": {
            "type": "number"
          },
          "label": {
            "enum": [
              "observed",
              "estimate",
              "forecast"
            ]
          },
          "source_note": {
            "type": "string"
          }
        }
      }
    }
  }
}
